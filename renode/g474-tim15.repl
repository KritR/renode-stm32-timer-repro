// Just enough of an STM32G474 for embassy_stm32::init and its time
// driver on TIM15.

// RCC: every oscillator and the PLL are ready as soon as they are
// enabled, and the clock switch reports the source asked for; the rest
// reads back as written. All embassy_stm32::init waits on.
rcc: Python.PythonPeripheral @ sysbus 0x40021000
    size: 0x400
    initable: true
    script: '''
CR, CFGR, BDCR, CSR, CRRCR = 0x00, 0x08, 0x90, 0x94, 0x98

READY = {
    CR: [(8, 10), (16, 17), (24, 25)],  # HSI16, HSE, PLL
    BDCR: [(0, 1)],                     # LSE
    CSR: [(0, 1)],                      # LSI
    CRRCR: [(0, 1)],                    # HSI48
}

if request.IsInit:
    regs = {CR: 0x00000500, CFGR: 0x00000005}
elif request.IsWrite:
    regs[request.Offset] = request.Value
elif request.IsRead:
    value = regs.get(request.Offset, 0)
    for enable, ready in READY.get(request.Offset, []):
        value = (value & ~(1 << ready)) | (((value >> enable) & 1) << ready)
    if request.Offset == CFGR:
        value = (value & ~0xC) | ((value & 0x3) << 2)
    request.Value = value
'''

nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    priorityMask: 0xF0
    systickFrequency: 16000000
    IRQ -> cpu@0

cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m4f"
    nvic: nvic

flash: Memory.MappedMemory @ sysbus 0x08000000
    size: 0x80000

sram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x20000

pwr: Memory.ArrayMemory @ sysbus 0x40007000
    size: 0x400

flashInterface: Memory.ArrayMemory @ sysbus 0x40022000
    size: 0x400

gpioPortA: GPIOPort.STM32_GPIOPort @ sysbus <0x48000000, +0x400>
    modeResetValue: 0xABFFFFFF
    numberOfAFs: 16
    5 -> led@0

led: Miscellaneous.LED @ gpioPortA 5

// embassy's time driver: 16 MHz (HSI, embassy's default clocks).
timer15: Timers.STM32_Timer @ sysbus 0x40014000
    -> nvic@24
    frequency: 16000000
    initialLimit: 0xFFFF

sysbus:
    init:
        Tag <0xE0042000 0x400> "DBGMCU"
